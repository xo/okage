# Every text file is LF on every checkout, including a checkout on Windows.
# Git for Windows writes CRLF by default. See dbmeta D89 and D110.
* text=auto eol=lf

# The reference images, the test fonts and the test files of upstream are
# copies of the files of upstream, byte for byte (docs/UPSTREAM.md). Git must
# not change them. An SVG file of a test can hold CRLF line ends on purpose.
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.svgz binary
*.ttf binary
*.otf binary
*.ttc binary
*.woff binary
*.woff2 binary
*.eot binary
*.bin binary
# The fonts of typesetting-utils in typesetting/testdata (D63).
*.cff binary
*.dfont binary
*.otb binary
# The ICC profiles in pdf/icc are the files of krilla, byte for byte.
*.icc binary
# A pattern with a slash matches from the root only, so the leading **/
# keeps the bytes of the test data of every package at any depth, such as
# the files with NUL bytes and Latin-1 text of html/testdata/tinyhtml5.
**/testdata/** -text
